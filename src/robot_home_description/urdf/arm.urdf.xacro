<?xml version="1.0"?>
<!-- 6DOF机械臂描述 - 家用小型机械臂 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm" params="parent *origin">

    <!-- 关节连接 -->
    <joint name="arm_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="arm_base_link"/>
    </joint>

    <!-- 机械臂基座 -->
    <link name="arm_base_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.04"/>
        </geometry>
        <material name="dark_blue">
          <color rgba="0.2 0.3 0.6 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- 关节1: 基座旋转 (yaw) -->
    <joint name="arm_joint_1" type="revolute">
      <parent link="arm_base_link"/>
      <child link="arm_link_1"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="1.5"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="arm_link_1">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.1"/>
        </geometry>
        <material name="silver">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <origin xyz="0 0 0.05"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0002"/>
      </inertial>
    </link>

    <!-- 关节2: 肩部 (pitch) -->
    <joint name="arm_joint_2" type="revolute">
      <parent link="arm_link_1"/>
      <child link="arm_link_2"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="15" velocity="1.2"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="arm_link_2">
      <visual>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.14"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.14"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.35"/>
        <origin xyz="0 0 0.07"/>
        <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- 关节3: 肘部 (pitch) -->
    <joint name="arm_joint_3" type="revolute">
      <parent link="arm_link_2"/>
      <child link="arm_link_3"/>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.0" upper="2.0" effort="12" velocity="1.5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>

    <link name="arm_link_3">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.018" length="0.12"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.018" length="0.12"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0.06"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- 关节4: 腕部旋转 (roll) -->
    <joint name="arm_joint_4" type="revolute">
      <parent link="arm_link_3"/>
      <child link="arm_link_4"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-3.14" upper="3.14" effort="5" velocity="2.0"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>

    <link name="arm_link_4">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.04"/>
        </geometry>
        <material name="dark_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <!-- 关节5: 腕部俯仰 (pitch) -->
    <joint name="arm_joint_5" type="revolute">
      <parent link="arm_link_4"/>
      <child link="arm_link_5"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>

    <link name="arm_link_5">
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.012" length="0.03"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.012" length="0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00003"/>
      </inertial>
    </link>

    <!-- 关节6: 末端旋转 (yaw) -->
    <joint name="arm_joint_6" type="revolute">
      <parent link="arm_link_5"/>
      <child link="arm_link_6"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="3" velocity="2.5"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <link name="arm_link_6">
      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.02"/>
        </geometry>
        <material name="dark_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
