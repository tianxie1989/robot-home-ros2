<?xml version="1.0"?>
<!-- 电动平行夹爪描述 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gripper" params="parent *origin">

    <!-- 夹爪基座连接 -->
    <joint name="gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
    </joint>

    <!-- 夹爪基座 -->
    <link name="gripper_base_link">
      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.02"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.4 0.4 0.4 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00003"/>
      </inertial>
    </link>

    <!-- 左指 -->
    <joint name="gripper_left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="gripper_left_finger_link"/>
      <origin xyz="0 0.015 0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.04" effort="10" velocity="0.1"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="gripper_left_finger_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.005 0.04"/>
        </geometry>
        <material name="rubber">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.005 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000005"/>
      </inertial>
    </link>

    <!-- 右指 (mimic关节，跟随左指) -->
    <joint name="gripper_right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="gripper_right_finger_link"/>
      <origin xyz="0 -0.015 0.02" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="0.04" effort="10" velocity="0.1"/>
      <mimic joint="gripper_left_finger_joint" multiplier="1" offset="0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="gripper_right_finger_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.005 0.04"/>
        </geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.005 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000005"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
