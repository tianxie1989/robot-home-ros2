<?xml version="1.0" ?>
<!--
  简单客厅 Gazebo 仿真世界
  simulation_world/worlds/living_room.world

  包含: 地面、四面墙壁、天花板光源、几件简单家具(桌子、书架、收纳箱)
-->
<sdf version="1.6">
  <world name="living_room">

    <!-- 物理引擎 -->
    <physics name="default_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <!-- 场景设置 -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.8 0.9 1.0 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 太阳光源 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1.0</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- 室内点光源 -->
    <light name="ceiling_light" type="point">
      <pose>0 0 2.8 0 0 0</pose>
      <diffuse>0.8 0.8 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.7 0.5 1</ambient>
            <diffuse>0.8 0.7 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 北墙 (Y+) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 南墙 (Y-) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 东墙 (X+) -->
    <model name="wall_east">
      <static>true</static>
      <pose>3.0 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 西墙 (X-) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3.0 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.15 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 咖啡桌 -->
    <model name="coffee_table">
      <static>true</static>
      <pose>0.5 0.5 0.25 0 0 0</pose>
      <link name="link">
        <!-- 桌面 -->
        <collision name="top_collision">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.5 0.04</size></box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.5 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <!-- 桌腿 -->
        <collision name="leg1">
          <pose>0.35 0.2 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>0.35 0.2 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.15 1</ambient>
            <diffuse>0.5 0.3 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="leg2">
          <pose>-0.35 0.2 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        </collision>
        <collision name="leg3">
          <pose>0.35 -0.2 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        </collision>
        <collision name="leg4">
          <pose>-0.35 -0.2 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- 收纳箱 -->
    <model name="storage_box">
      <static>true</static>
      <pose>-1.5 2.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.3 0.3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.3 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 书架 -->
    <model name="bookshelf">
      <static>true</static>
      <pose>2.5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 1.0 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.3 1.0 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
