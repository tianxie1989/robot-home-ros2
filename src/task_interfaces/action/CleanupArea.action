# 区域整理动作
# task_interfaces/action/CleanupArea.action

# --- 目标 (Goal) ---
# 区域名称 (如: "living_room", "bedroom", "playroom")
string area_name

# 目标类别列表 (需要整理的物体类别，为空则整理所有)
string[] target_categories
---
# --- 结果 (Result) ---
# 是否全部整理成功
bool success

# 整理的物品总数
uint32 total_items_cleaned

# 整理的物品名称列表
string[] cleaned_items

# 整理失败的物品名称列表
string[] failed_items

# 描述信息
string message
---
# --- 反馈 (Feedback) ---
# 当前进度 (0.0 ~ 1.0)
float32 progress

# 当前正在处理的物品名称
string current_item

# 已整理完成的物品数
uint32 items_done

# 剩余待整理物品数
uint32 items_remaining

# 当前阶段 (scanning, picking, placing, verifying)
string current_phase
