# 抓取放置动作
# task_interfaces/action/PickAndPlace.action

# --- 目标 (Goal) ---
# 目标物体类别名称 (如: "toy_block", "storage_box")
string target_object_class

# 目标物体的3D位姿 (抓取位置)
geometry_msgs/Pose target_pose

# 放置位置的3D位姿
geometry_msgs/Pose place_pose

# 最大尝试次数
uint8 max_attempts
---
# --- 结果 (Result) ---
# 是否成功
bool success

# 实际放置位置
geometry_msgs/Pose actual_place_pose

# 描述信息
string message
---
# --- 反馈 (Feedback) ---
# 当前阶段 (detecting, navigating, picking, lifting, placing)
string current_phase

# 进度 (0.0 ~ 1.0)
float32 progress

# 当前抓取的物体名称
string grabbed_object
