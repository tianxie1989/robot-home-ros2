<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voice_interaction</name>
  <version>0.1.0</version>
  <description>语音交互功能包：sherpa-onnx 流式 ASR、Piper TTS、Ollama LLM 对话</description>
  <maintainer email="team@robathome.local">Robot Home Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Python pip 依赖（需在系统或虚拟环境中安装）:
    - sherpa-onnx: 流式语音识别引擎
    - sounddevice: 麦克风录音
    - piper: Piper TTS 语音合成
    - numpy: 音频数据处理
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
